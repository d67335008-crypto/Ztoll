<Window x:Class="Ztoll.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Ztoll.Views"
        Title="Ztoll"
        Width="520" Height="230"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" Topmost="True" ResizeMode="NoResize" ShowActivated="False"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}">
    <Grid>
        <Border x:Name="Island"
                HorizontalAlignment="Center" VerticalAlignment="Top"
                Width="190" Height="36" CornerRadius="18"
                Background="{DynamicResource IslandBackground}"
                BorderBrush="{DynamicResource IslandBorder}" BorderThickness="1"
                ClipToBounds="True"
                MouseEnter="Island_MouseEnter" MouseLeave="Island_MouseLeave"
                MouseLeftButtonUp="Island_MouseLeftButtonUp">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Direction="270" Opacity="0.35" Color="#000000" />
            </Border.Effect>
            <Grid>
                <!-- Collapsed content -->
                <Grid x:Name="CompactPanel" Margin="14,0">
                    <TextBlock x:Name="CompactTime" HorizontalAlignment="Left" VerticalAlignment="Center"
                               FontFamily="{StaticResource DisplayFont}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{DynamicResource PrimaryText}" />
                    <views:BatteryIndicator x:Name="CompactBattery" HorizontalAlignment="Right" VerticalAlignment="Center"
                                            FontSize="12" />
                </Grid>

                <!-- Expanded content (fixed size, revealed by the growing island) -->
                <Grid x:Name="ExpandedPanel" Width="436" Height="168"
                      HorizontalAlignment="Center" VerticalAlignment="Top"
                      Visibility="Collapsed" Opacity="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="26,20,26,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock x:Name="ExpandedTime" FontFamily="{StaticResource DisplayFont}"
                                       FontSize="40" FontWeight="Light" Foreground="{DynamicResource PrimaryText}" />
                            <TextBlock x:Name="ExpandedDate" FontSize="13" Margin="2,0,0,0"
                                       Foreground="{DynamicResource SecondaryText}" />
                        </StackPanel>
                        <Border x:Name="BatteryChip" Grid.Column="1" VerticalAlignment="Center"
                                Background="{DynamicResource ChipBackground}" CornerRadius="14" Padding="12,8">
                            <StackPanel>
                                <views:BatteryIndicator x:Name="ExpandedBattery" FontSize="14" />
                                <TextBlock x:Name="BatteryCaption" FontSize="11" Margin="0,3,0,0"
                                           Foreground="{DynamicResource SecondaryText}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                        <Button x:Name="BtnSettings" Style="{StaticResource IconButton}" Content="&#xE713;"
                                ToolTip="Ztoll Settings" Click="BtnSettings_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnTheme" Style="{StaticResource IconButton}" Content="&#xE706;"
                                ToolTip="Toggle dark / light theme" Click="BtnTheme_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnSnip" Style="{StaticResource IconButton}" Content="&#xE722;"
                                ToolTip="Screenshot (Snipping Tool)" Click="BtnSnip_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnLock" Style="{StaticResource IconButton}" Content="&#xE72E;"
                                ToolTip="Lock this PC" Click="BtnLock_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnCollapse" Style="{StaticResource IconButton}" Content="&#xE70E;"
                                ToolTip="Collapse" Click="BtnCollapse_Click" Margin="0,0,10,0" />
                        <Button x:Name="BtnQuit" Style="{StaticResource IconButton}" Content="&#xE7E8;"
                                ToolTip="Quit Ztoll" Click="BtnQuit_Click" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
