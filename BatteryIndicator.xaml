<UserControl x:Class="Ztoll.Views.BatteryIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Grid Width="27" Height="13" VerticalAlignment="Center">
            <Border x:Name="Outline" Width="24" Height="13" HorizontalAlignment="Left"
                    CornerRadius="3.5" BorderThickness="1.4" BorderBrush="{DynamicResource SecondaryText}">
                <Border x:Name="Fill" Margin="1.6" CornerRadius="1.8" HorizontalAlignment="Left" Width="0"
                        Background="{DynamicResource PrimaryText}" />
            </Border>
            <Border x:Name="Nub" Width="2.4" Height="5" HorizontalAlignment="Right" VerticalAlignment="Center"
                    CornerRadius="0,1.5,1.5,0" Background="{DynamicResource SecondaryText}" />
        </Grid>
        <TextBlock x:Name="Label" Margin="7,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"
                   Foreground="{DynamicResource PrimaryText}" />
    </StackPanel>
</UserControl>
